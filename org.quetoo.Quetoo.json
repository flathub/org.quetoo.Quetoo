{
  "app-id":"org.quetoo.Quetoo",
  "command":"quetoo",
  "runtime":"org.freedesktop.Platform",
  "runtime-version":"25.08",
  "sdk":"org.freedesktop.Sdk",
  "finish-args":[
    "--share=ipc",
    "--socket=x11",
    "--socket=wayland",
    "--device=dri",
    "--share=network",
    "--socket=pulseaudio",
    "--system-talk-name=org.freedesktop.UPower",
    "--persist=.quetoo"
  ],
  "__cleanup":[
    "/bin/checkmk",
    "/bin/test_physfs",
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/aclocal",
    "/share/doc",
    "/share/info",
    "/share/pkgconfig",
    "/share/man",
    "*.la",
    "*.a"
  ],
  "modules":[
    {
      "name":"Check",
      "disabled": true,
      "sources":[
        {
          "type":"git",
          "url":"https://github.com/libcheck/check.git",
          "commit": "90db730441bab1656c4447fafd45ffa39660f408"
        },
        {
          "type":"script",
          "commands":[
            "autoreconf -fiv"
          ],
          "dest-filename":"autogen.sh"
        }
      ]
    },
    {
        "name": "check",
        "buildsystem": "autotools",
        "sources": [
            {
                "type": "archive",
                "url": "https://github.com/libcheck/check/releases/download/0.15.2/check-0.15.2.tar.gz",
                "sha256": "a8de4e0bacfb4d76dd1c618ded263523b53b85d92a146d8835eb1a52932fa20a"
            }
        ]
    },
    {
      "name":"Objectively",
      "sources":[
        {
          "type":"git",
          "url":"https://github.com/jdolan/Objectively.git",
          "commit": "8b40fe53a376ba312c0e0df45f40d9d1bb7ff914"
        },
        {
          "type":"script",
          "commands":[
            "autoreconf -fiv"
          ],
          "dest-filename":"autogen.sh"
        }
      ]
    },
    "shared-modules/SDL2/SDL2_image.json",
    "shared-modules/SDL2/SDL2_ttf.json",
    {
      "name":"ObjectivelyMVC",
      "sources":[
        {
          "type":"git",
          "url":"https://github.com/jdolan/ObjectivelyMVC.git",
          "tag": "v0.1.1",
          "commit": "d0df5ba97349cb0e79b293bb3d88191b3d015bc7"
        },
        {
          "type":"script",
          "commands":[
            "autoreconf -fiv"
          ],
          "dest-filename":"autogen.sh"
        }
      ]
    },
    "shared-modules/physfs/physfs.json",
    {
      "name":"Quetoo",
      "sources":[
        {
          "type":"git",
          "url":"https://github.com/jdolan/quetoo.git",
          "tag": "v0.5.8",
          "commit": "5b8b7dabe107795b7af0bfb0e7ea1eb4139c9fb9"
        },
        {
          "type":"script",
          "commands":[
            "autoreconf -fiv"
          ],
          "dest-filename":"autogen.sh"
        }
      ]
    },
    {
      "name":"Quetoo-Data",
      "buildsystem":"simple",
      "build-commands":[
        "bsdtar -xf quetoo-bundle.tar.gz --strip-components=1",
        "cp -r share/quetoo/default /app/share/quetoo"
      ],
      "sources":[
        {
          "type":"archive",
          "filename": "quetoo-bundle.tar.gz",
          "url":"https://github.com/jdolan/quetoo/releases/download/v0.5.8/quetoo-bundle-x86_64-pc-linux.tar.gz",
          "sha256":"76cd24c98bce1aefb814543475e195171e931b05fef6414faf991db0a650a0a4"
        }
      ]
    },
    {
      "name":"metadata",
      "buildsystem":"simple",
      "build-commands":[
        "install -Dm644 org.quetoo.Quetoo.appdata.xml -t /app/share/metainfo/",
        "install -Dm644 org.quetoo.Quetoo.desktop -t /app/share/applications/",
        "install -Dm644 org.quetoo.Quetoo.png -t /app/share/icons/hicolor/256x256/apps/"
      ],
      "sources":[
        {
          "type":"file",
          "path":"org.quetoo.Quetoo.appdata.xml"
        },
        {
          "type":"file",
          "path":"org.quetoo.Quetoo.desktop"
        },
        {
          "type":"file",
          "path":"org.quetoo.Quetoo.png"
        }
      ]
    }
  ]
}
